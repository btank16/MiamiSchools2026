{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Miami Schools API: proxies GreatSchools, Google Places and Miami-Dade County GIS",
  "type": "commonjs",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx scripts/dev-server.ts",
    "sandbox": "ampx sandbox",
    "typecheck": "tsc --noEmit",
    "dev:chat": "node --env-file-if-exists=.env --import tsx scripts/chat-dev-server.ts",
    "build:chat-data": "tsx scripts/build-chat-data.ts",
    "test": "tsx --test amplify/functions/chat-api/*.test.ts"
  },
  "license": "ISC",
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.4.25",
    "aws-amplify": "^6.22.2",
    "zod": "^3.25.17"
  }
}
