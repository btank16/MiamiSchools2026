{
  "name": "miami-schools-chatbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chatbot that answers questions about Miami-Dade schools from school-data/schools.csv",
  "scripts": {
    "start": "tsx src/server.ts",
    "chat": "tsx src/cli.ts",
    "app": "node scripts/dev-app.mjs",
    "app:build": "cd ../frontend && ./node_modules/.bin/vite build --config ../chatbot/app.vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
