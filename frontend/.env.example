VITE_MAPBOX_TOKEN=
# Leave empty to use the deployed API from amplify_outputs.json. Set to http://localhost:3001
# to use a local backend (`npm run dev` in backend/).
VITE_API_URL=
# Leave empty to use the deployed chatbot from amplify_outputs.json (custom.chat.endpoint). Set to
# http://localhost:3002 to use a local chat server (`npm run dev:chat` in backend/).
VITE_CHAT_URL=
